{
  "manifest_version": 3,
  "name": "RoLens: Roblox Trade Values",
  "short_name": "RoLens",
  "description": "Item values, USD estimates and trade analysis from Rolimon's and RoUtility, directly on Roblox. Open source, with no account access.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "RoLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-serials": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Hide or show serial numbers"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.rolimons.com/*", "https://routility.io/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src https://api.rolimons.com https://routility.io"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/inter-latin.woff2"],
      "matches": ["https://www.roblox.com/*"],
      "use_dynamic_url": true
    }
  ]
}
