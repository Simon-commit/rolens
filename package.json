{
  "name": "rolens",
  "version": "0.15.1",
  "private": true,
  "description": "Open source, privacy-first Chrome extension that shows Roblox limited trade values on Roblox pages.",
  "license": "MIT",
  "author": "Simon (https://github.com/Simon-commit)",
  "homepage": "https://github.com/Simon-commit/rolens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simon-commit/rolens.git"
  },
  "bugs": {
    "url": "https://github.com/Simon-commit/rolens/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "node test/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/chrome": "^0.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
